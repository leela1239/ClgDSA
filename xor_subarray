    #include<bits/stdc++.h>
    using namespace std;
    vector<int> specialXor(int n, int Q, int a[], vector<int> q[])
    {
        int p[n]={0};
        p[0]=a[0];
        vector<int>v;
        for(int i=1;i<n;i++)
        {
            p[i]=p[i-1]^a[i];
        }
        int l,r;
        for(int i=0;i<Q;q++)
        {
            q[i][0]=l;
            q[i][1]=r;
            if(l!=1)
            {
                v.push_back(p[l-1]^p[r]^p[n-1]);
            }
            else
            {
                v.push_back(p[r]^p[n-1]);
            }
            
        }
        return v;
    }